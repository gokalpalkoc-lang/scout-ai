  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev:clear": "expo start -c",
    "doctor": "npx expo-doctor",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --clean",
    "build:apk": "eas build -p android --profile preview",
    "build:local": "eas build -p android --profile preview --local",
    "android:emulator": "ANDROID_HOME=$HOME/Android/Sdk PATH=$HOME/Android/Sdk/platform-tools:$HOME/Android/Sdk/emulator:$PATH expo start --android",
